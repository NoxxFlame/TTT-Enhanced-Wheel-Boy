"UnlitGeneric"
{
    "$basetexture" "wheelboy/wheel_overlay_old"
    "$translucent" "1"
    "$vertexcolor" "1"
    "$vertexalpha" "1"

    "Proxies"
    {
        "AnimatedTexture"
        {
            "animatedtexturevar"         "$basetexture"
            "animatedtextureframenumvar" "$frame"
            "animatedtextureframerate"   "30"
        }
    }
}